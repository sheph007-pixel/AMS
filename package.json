    "@types/react": "^19.2.14",
    "fast-xml-parser": "^5.5.7",
    "lucide-react": "^0.577.0",
    "next": "^15.3.0",
    "openai": "^6.33.0",
    "postcss": "^8.5.8",
    "prisma": "^5.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "xlsx": "^0.18.5"
  }
