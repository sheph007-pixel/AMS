generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Canonical deduplicated client/group record.
/// A client appears once regardless of how many annual XMLs reference them.
model Client {
  id        String   @id @default(cuid())
  groupId   String   @unique /// External group identifier from XML
  groupName String
  sicCode   String?
  state     String?
  metadata  String?  /// Raw source metadata as JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots ClientSnapshot[]
}

/// One row per client per year. Represents the client's state in a given annual snapshot.
model ClientSnapshot {
  id       String @id @default(cuid())
  clientId String
  year     Int
  month    Int    @default(0) /// 1-12, or 0 for unspecified

  groupName       String
  totalEmployees  Int?
  totalMembers    Int?
  effectiveDate   String?
  renewalDate     String?
  sicCode         String?
  state           String?
  metadata        String? /// Additional raw fields as JSON

  importedAt DateTime @default(now())

  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  benefitPlans  BenefitPlan[]
  employees     EmployeeSnapshot[]

  @@unique([clientId, year, month])
  @@index([year, month])
}

/// A benefit plan attached to a client snapshot (year-specific).
model BenefitPlan {
  id               String @id @default(cuid())
  clientSnapshotId String

  planType    String  /// e.g. Medical, Dental, Vision, Life
  carrier     String?
  planName    String?
  eligible    Int?    /// Number of employees eligible for this plan
  enrollees   Int?
  premium     Float?
  metadata    String? /// Raw plan data as JSON

  /// Exclusion tracking — plan is stored but may be excluded from reports
  excluded       Boolean @default(false) /// true = excluded at import time
  excludeReason  String? /// Why excluded: "exclusion_rule", "cobra", etc.

  clientSnapshot ClientSnapshot @relation(fields: [clientSnapshotId], references: [id], onDelete: Cascade)

  @@index([clientSnapshotId])
}

/// Exclusion rule — carriers/entities that must be filtered out of the system.
model ExclusionRule {
  id          String   @id @default(cuid())
  field       String   /// Field to match: "carrier", "planName", "groupName"
  value       String   /// Exact value to exclude
  description String?  /// Human-readable reason for the rule
  createdAt   DateTime @default(now())

  @@unique([field, value])
}

/// One row per employee per client per year.
model EmployeeSnapshot {
  id               String @id @default(cuid())
  clientSnapshotId String

  employeeId  String  /// External employee identifier
  firstName   String
  lastName    String
  dateOfBirth String?
  hireDate    String?
  termDate    String?
  status      String? /// Active, Terminated, etc.
  coverageTier String? /// EE, EE+SP, EE+CH, FAM
  metadata    String? /// Raw employee data as JSON

  clientSnapshot ClientSnapshot @relation(fields: [clientSnapshotId], references: [id], onDelete: Cascade)

  @@unique([clientSnapshotId, employeeId])
  @@index([clientSnapshotId])
}

// ─── Financial Data Models ───────────────────────────────────────────────────

/// Business entity — Kennion or NIA.
model FinancialEntity {
  id          String   @id @default(cuid())
  name        String   @unique /// "Kennion" or "NIA"
  description String?

  accounts     ChartOfAccounts[]
  transactions FinancialTransaction[]
  statements   FinancialStatement[]
  summaries    FinancialSummary[]
}

/// Chart of accounts from QuickBooks.
model ChartOfAccounts {
  id            String  @id @default(cuid())
  entityId      String
  accountNumber String
  accountName   String
  accountType   String  /// Asset, Liability, Equity, Revenue, Expense
  parentAccount String?

  entity       FinancialEntity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  summaries    FinancialSummary[]

  @@unique([entityId, accountNumber])
}

/// General ledger transaction detail rows.
model FinancialTransaction {
  id              String @id @default(cuid())
  entityId        String
  accountId       String
  year            Int
  month           Int
  date            String
  transactionType String  /// Invoice, Check, Journal Entry, etc.
  reference       String?
  memo            String?
  debit           Float   @default(0)
  credit          Float   @default(0)
  metadata        String?

  entity  FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([entityId, year, month])
  @@index([accountId])
}

/// Tracking record for uploaded financial statements.
model FinancialStatement {
  id            String   @id @default(cuid())
  entityId      String
  statementType String   /// income_statement, balance_sheet, general_ledger
  year          Int
  month         Int      @default(0)
  fileName      String
  rowCount      Int      @default(0)
  importedAt    DateTime @default(now())
  metadata      String?

  entity FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, statementType, year, month])
}

/// Pre-aggregated monthly financial summary line items.
model FinancialSummary {
  id            String @id @default(cuid())
  entityId      String
  statementType String
  accountId     String
  year          Int
  month         Int
  amount        Float
  metadata      String?

  entity  FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entityId, accountId, year, month, statementType])
}

// ─── Carrier Settings ───────────────────────────────────────────────────────

/// Carrier-level settings: income method, rate, and exclusion.
/// Auto-populated from EN XML data. Each carrier uses one method: PEPM, PERCENT_PREMIUM, or NONE.
model CarrierSetting {
  id           String  @id @default(cuid())
  carrierName  String  @unique /// Carrier name as it appears in EN XML
  incomeMethod String  @default("NONE") /// PEPM, PERCENT_PREMIUM, or NONE
  rate         Float   @default(0) /// PEPM dollar amount or percent (e.g. 20 or 10)
  excluded     Boolean @default(false) /// If true, carrier is excluded from all reports

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Schema Management ──────────────────────────────────────────────────────

/// Uploaded XSD schema file with versioning. Never overwritten.
model SchemaVersion {
  id         String   @id @default(cuid())
  name       String   /// Human label, e.g. "EN BDX v2.1"
  version    String   /// Version label, e.g. "2.1", "inferred-1"
  status     String   @default("inactive") /// "active", "inactive", "archived"
  xsdContent String   /// Raw XSD file content
  notes      String?
  uploadedBy String   @default("admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields      SchemaField[]
  mappings    FieldMapping[]
  testResults SchemaTestResult[]

  @@unique([name, version])
  @@index([status])
}

/// Parsed field from an XSD schema. One row per element/attribute.
model SchemaField {
  id              String  @id @default(cuid())
  schemaVersionId String

  xmlPath     String  /// Full dot-path: "Data.Companies.Company.Plans.Plan.PlanCost"
  elementName String  /// Leaf name: "PlanCost"
  xmlType     String  /// XSD type: "xs:string", "xs:decimal", "xs:date", etc.
  isRequired  Boolean @default(false)
  isRepeating Boolean @default(false) /// maxOccurs > 1
  isNillable  Boolean @default(false)
  isAttribute Boolean @default(false) /// true if XSD attribute vs element
  parentPath  String? /// Parent element path for tree rendering
  depth       Int     @default(0) /// Nesting depth
  sortOrder   Int     @default(0)

  schemaVersion SchemaVersion @relation(fields: [schemaVersionId], references: [id], onDelete: Cascade)
  mappings      FieldMapping[]

  @@unique([schemaVersionId, xmlPath])
  @@index([schemaVersionId])
}

/// Admin-configured mapping from an XML field path to a DB/report target.
/// Keyed by xmlPath. schemaFieldId is optional (XML can have fields not in XSD).
model FieldMapping {
  id              String  @id @default(cuid())
  schemaVersionId String
  schemaFieldId   String? /// Optional link to SchemaField (null for discovered-only fields)
  xmlPath         String  /// The XML dot-path this mapping applies to

  included       Boolean @default(true) /// false = explicitly excluded
  targetModel    String? /// "Client", "BenefitPlan", "EmployeeSnapshot", etc.
  targetColumn   String? /// DB column name
  reportingName  String? /// Display name in reports
  targetType     String? /// "string", "number", "date", "boolean"
  transformRule  String? /// Transform expression or preset key
  fallbackFields String? /// JSON array of free-form xmlPath strings
  notes          String?
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schemaVersion SchemaVersion @relation(fields: [schemaVersionId], references: [id], onDelete: Cascade)
  schemaField   SchemaField?  @relation(fields: [schemaFieldId], references: [id], onDelete: SetNull)
  auditEntries  MappingAudit[]

  @@unique([schemaVersionId, xmlPath])
  @@index([schemaVersionId])
  @@index([targetModel, targetColumn])
}

/// Audit log for every mapping change.
model MappingAudit {
  id             String   @id @default(cuid())
  fieldMappingId String
  action         String   /// "created", "updated", "deleted"
  changedBy      String   @default("admin")
  changedField   String?
  oldValue       String?
  newValue       String?

  createdAt DateTime @default(now())

  fieldMapping FieldMapping @relation(fields: [fieldMappingId], references: [id], onDelete: Cascade)

  @@index([fieldMappingId])
  @@index([createdAt])
}

/// Business validation rules (separate from XSD structural validation).
model ValidationRule {
  id         String  @id @default(cuid())
  name       String  @unique /// "valid-hire-date", "premium-positive", etc.
  category   String  /// "date", "enrollment", "premium", "carrier", "identity"
  expression String  /// Rule logic as JSON
  severity   String  @default("warning") /// "error", "warning", "info"
  enabled    Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fields discovered in XML during test runs or imports (not in XSD).
model DiscoveredField {
  id              String   @id @default(cuid())
  xmlPath         String
  schemaVersionId String?  /// Null if discovered without any active schema
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  seenInTest      Boolean  @default(false)
  seenInImport    Boolean  @default(false)
  sampleValue     String?  /// First non-null value seen (for type inference)

  @@unique([xmlPath, schemaVersionId])
  @@index([schemaVersionId])
}

/// Results from test file validation runs. Coverage counts persisted at test time.
model SchemaTestResult {
  id              String @id @default(cuid())
  schemaVersionId String
  fileName        String
  fileSize        Int
  status          String /// "pass", "fail", "warnings"

  /// Coverage metrics (persisted snapshot — not recomputed from mappings)
  totalDiscoveredFields Int @default(0) /// Total unique XML paths found at runtime
  mappedFields          Int @default(0) /// Discovered fields that have a FieldMapping
  unmappedFields        Int @default(0) /// Discovered fields with NO mapping (mapped + unmapped == total)
  includedFields        Int @default(0) /// Mapped fields where included = true
  excludedFields        Int @default(0) /// Mapped fields where included = false (included + excluded == mapped)

  errors         String? /// JSON array of error objects
  warnings       String? /// JSON array of warning objects
  parsedPreview  String? /// JSON: per-field detail [{xmlPath, mappingStatus, targetColumn, value, sourceUsed}]

  createdAt DateTime @default(now())

  schemaVersion SchemaVersion @relation(fields: [schemaVersionId], references: [id], onDelete: Cascade)

  @@index([schemaVersionId])
}

// ─── Report Audit ───────────────────────────────────────────────────────────

/// Persisted audit run for production report verification.
/// Deterministic checks are the primary verification signal.
/// AI review is optional and stored as a note only.
model ReportAudit {
  id        String   @id @default(cuid())

  /// Scope
  reportType String  /// "production", "production-dashboard"
  scope      String  /// JSON: { years, months, carriers, clients } — filters at audit time
  status     String  /// "verified", "warning", "needs_review"

  /// Deterministic check results
  checksRun    Int     @default(0)
  checksPassed Int     @default(0)
  checksFailed Int     @default(0)
  checksDetail String? /// JSON array of { name, status, message, expected?, actual? }

  /// Report totals (from cached report)
  reportTotalRows     Int     @default(0)
  reportTotalLives    Int     @default(0)
  reportTotalPremium  Float   @default(0)
  reportTotalIncome   Float   @default(0)

  /// Independent recomputation totals
  auditTotalRows     Int     @default(0)
  auditTotalLives    Int     @default(0)
  auditTotalPremium  Float   @default(0)
  auditTotalIncome   Float   @default(0)

  /// Variances (audit - report)
  varianceRows    Int     @default(0)
  varianceLives   Int     @default(0)
  variancePremium Float   @default(0)
  varianceIncome  Float   @default(0)

  /// Per-month subtotals (JSON: { "2023-07": { rows, lives, premium, income } })
  monthSubtotals  String? /// JSON object
  /// Top client/carrier subtotals (JSON)
  clientSubtotals  String? /// JSON array
  carrierSubtotals String? /// JSON array

  /// Optional AI anomaly review (NOT the primary signal)
  aiReviewCompleted Boolean  @default(false)
  aiNote            String?  /// AI-generated narrative, stored as note only
  aiReviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([reportType, createdAt])
  @@index([status])
}

// ─── Report Cache ───────────────────────────────────────────────────────────

/// Pre-computed report data. Rebuilt after each import.
/// Eliminates the need to re-process all employee metadata on every page load.
model ReportCache {
  id        String   @id @default(cuid())
  key       String   @unique /// "production", "dashboard", "income", "benefits"
  data      String   /// JSON blob of the full API response
  builtAt   DateTime @default(now())
  buildTimeMs Int    @default(0) /// How long it took to build (for monitoring)
}
