generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Canonical deduplicated client/group record.
/// A client appears once regardless of how many annual XMLs reference them.
model Client {
  id        String   @id @default(cuid())
  groupId   String   @unique /// External group identifier from XML
  groupName String
  sicCode   String?
  state     String?
  metadata  String?  /// Raw source metadata as JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots ClientSnapshot[]
}

/// One row per client per year. Represents the client's state in a given annual snapshot.
model ClientSnapshot {
  id       String @id @default(cuid())
  clientId String
  year     Int
  month    Int    @default(0) /// 1-12, or 0 for unspecified

  groupName       String
  totalEmployees  Int?
  totalMembers    Int?
  effectiveDate   String?
  renewalDate     String?
  sicCode         String?
  state           String?
  metadata        String? /// Additional raw fields as JSON

  importedAt DateTime @default(now())

  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  benefitPlans  BenefitPlan[]
  employees     EmployeeSnapshot[]

  @@unique([clientId, year, month])
}

/// A benefit plan attached to a client snapshot (year-specific).
model BenefitPlan {
  id               String @id @default(cuid())
  clientSnapshotId String

  planType    String  /// e.g. Medical, Dental, Vision, Life
  carrier     String?
  planName    String?
  eligible    Int?    /// Number of employees eligible for this plan
  enrollees   Int?
  premium     Float?
  metadata    String? /// Raw plan data as JSON

  clientSnapshot ClientSnapshot @relation(fields: [clientSnapshotId], references: [id], onDelete: Cascade)
}

/// Exclusion rule — carriers/entities that must be filtered out of the system.
model ExclusionRule {
  id          String   @id @default(cuid())
  field       String   /// Field to match: "carrier", "planName", "groupName"
  value       String   /// Exact value to exclude
  description String?  /// Human-readable reason for the rule
  createdAt   DateTime @default(now())

  @@unique([field, value])
}

/// One row per employee per client per year.
model EmployeeSnapshot {
  id               String @id @default(cuid())
  clientSnapshotId String

  employeeId  String  /// External employee identifier
  firstName   String
  lastName    String
  dateOfBirth String?
  hireDate    String?
  termDate    String?
  status      String? /// Active, Terminated, etc.
  coverageTier String? /// EE, EE+SP, EE+CH, FAM
  metadata    String? /// Raw employee data as JSON

  clientSnapshot ClientSnapshot @relation(fields: [clientSnapshotId], references: [id], onDelete: Cascade)

  @@unique([clientSnapshotId, employeeId])
}

// ─── Financial Data Models ───────────────────────────────────────────────────

/// Business entity — Kennion or NIA.
model FinancialEntity {
  id          String   @id @default(cuid())
  name        String   @unique /// "Kennion" or "NIA"
  description String?

  accounts     ChartOfAccounts[]
  transactions FinancialTransaction[]
  statements   FinancialStatement[]
  summaries    FinancialSummary[]
}

/// Chart of accounts from QuickBooks.
model ChartOfAccounts {
  id            String  @id @default(cuid())
  entityId      String
  accountNumber String
  accountName   String
  accountType   String  /// Asset, Liability, Equity, Revenue, Expense
  parentAccount String?

  entity       FinancialEntity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  summaries    FinancialSummary[]

  @@unique([entityId, accountNumber])
}

/// General ledger transaction detail rows.
model FinancialTransaction {
  id              String @id @default(cuid())
  entityId        String
  accountId       String
  year            Int
  month           Int
  date            String
  transactionType String  /// Invoice, Check, Journal Entry, etc.
  reference       String?
  memo            String?
  debit           Float   @default(0)
  credit          Float   @default(0)
  metadata        String?

  entity  FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Tracking record for uploaded financial statements.
model FinancialStatement {
  id            String   @id @default(cuid())
  entityId      String
  statementType String   /// income_statement, balance_sheet, general_ledger
  year          Int
  month         Int      @default(0)
  fileName      String
  rowCount      Int      @default(0)
  importedAt    DateTime @default(now())
  metadata      String?

  entity FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, statementType, year, month])
}

/// Pre-aggregated monthly financial summary line items.
model FinancialSummary {
  id            String @id @default(cuid())
  entityId      String
  statementType String
  accountId     String
  year          Int
  month         Int
  amount        Float
  metadata      String?

  entity  FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entityId, accountId, year, month, statementType])
}
